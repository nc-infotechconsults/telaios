# =============================================================
# Telaios — Environment Variables (monolith server/)
# Copy to .env at repo root and fill in your values.
# Loaded by server/src/telaios/config/settings.py
# =============================================================

# --- Runtime ------------------------------------------------
ENVIRONMENT=development          # development | production | test
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Slim-deploy: comma-separated module names to mount; empty = all.
# Example: TELAIOS_MODULES=users,projects,workspaces,messages
TELAIOS_MODULES=

# --- Auth & crypto ------------------------------------------
JWT_SECRET=change_me_to_32_char_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_SECONDS=604800    # 7 days
INTERNAL_API_KEY=change_me_internal_api_key
ENCRYPTION_KEY=change_me_to_32_char_random_string  # AES-256-CBC key

# --- Default admin user (seeded on first run) ---------------
ADMIN_EMAIL=admin@telaios.dev
ADMIN_PASSWORD=admin1234
ADMIN_DISPLAY_NAME=Admin

# --- Database (PostgreSQL via asyncpg) ----------------------
DATABASE_URL=postgresql+asyncpg://telaios:telaios@localhost:5432/telaios
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (events, jobs, caches) ---------------------------
REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO (document storage) --------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=telaios
S3_SECRET_KEY=telaios-secret
S3_BUCKET=telaios-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- LLM (planning agent fallback; DB settings override) ----
LLM_PROVIDER=openai              # openai | anthropic | ollama | vllm | lmstudio
LLM_MODEL=gpt-4o
LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1

# --- Embeddings (document RAG) ------------------------------
# EMBEDDING_PROVIDER: fastembed (default, in-process) | tei (TEI HTTP server)
EMBEDDING_PROVIDER=fastembed
# fastembed (in-process): intfloat/multilingual-e5-large — 1024 dims, 100+ languages, ~560MB
# tei (server):           BAAI/bge-m3 — 1024 dims, superior quality, needs TEI container
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_API_KEY=
# For TEI: set base URL of running TEI container (e.g. http://localhost:8080)
# EMBEDDING_BASE_URL=http://localhost:8080

# --- Qdrant vector store ------------------------------------
# Use QDRANT_URL for cloud/remote Qdrant (overrides host:port).
# QDRANT_URL=https://xyz.qdrant.io
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

# --- Knowledge graph store ----------------------------------
# GRAPH_STORE_PROVIDER: networkx (in-memory) | neo4j | falkordb
GRAPH_STORE_PROVIDER=networkx

# Neo4j (production, persistent)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=telaios
# NEO4J_DATABASE=knowledge

# FalkorDB (lightweight alternative)
# FALKORDB_URI=redis://localhost:6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# --- Workspaces / agents ------------------------------------
WORKSPACES_ROOT=/tmp/telaios-workspaces
AGENT_POOL_SIZE=3
MAX_CONCURRENT_TASKS=1

# --- Container infra ----------------------------------------
# DOCKER_HOST=unix:///var/run/docker.sock
# KUBECONFIG=/path/to/kubeconfig
HELM_BIN=helm

# --- Skills -------------------------------------------------
# SKILLS_DIRECTORY defaults to <repo>/skills
SKILLS_AUTOLOAD=true
SKILLS_EXTRA_PATHS=

# --- Frontend (consumed by Vite) ----------------------------
VITE_API_URL=http://localhost:8000
