# =============================================================
# SWE AI Platform — Environment Variables
# Copy to .env and fill in your values
# =============================================================

# --- Encryption (32-char random string for AES-256) ----------
ENCRYPTION_KEY=change_me_to_32_char_random_string

# --- Data API (TypeScript + Express + TypeORM) ---------------
DATABASE_URL=postgres://sweai:sweai@localhost:5432/sweai
PORT=3000

# --- Agent Service (TypeScript + Express + LangGraph.js) -----
DATA_API_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
AGENT_SERVICE_PORT=8000
AGENT_POOL_SIZE=3

# Workspace root where repos will be cloned
WORKSPACES_ROOT=/tmp/swe-ai-workspaces

# --- Planning Agent LLM (stored in DB Settings, set via UI) --
# These are fallback defaults used before DB settings are configured.
# Cloud providers
LLM_PROVIDER=openai              # openai | anthropic | ollama | vllm | lmstudio
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...

# On-prem / Ollama example:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
# LLM_API_KEY=ollama

# On-prem / vLLM example:
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# LLM_API_KEY=token-abc

# On-prem / LM Studio example:
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-coder-7b-instruct
# LLM_API_KEY=lm-studio

# --- Frontend ------------------------------------------------
VITE_DATA_API_URL=http://localhost:3000
VITE_AGENT_SERVICE_URL=http://localhost:8000
