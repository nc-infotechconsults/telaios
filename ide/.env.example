# IDE Server
PORT=4000

# Workspace storage — path on the IDE server filesystem
WORKSPACES_ROOT=/tmp/ide-workspaces

# Docker — path that Docker on the HOST can bind-mount into workspace containers.
# When IDE server runs on the HOST this equals WORKSPACES_ROOT.
# When IDE server runs inside Docker, set this to the host-side bind-mount source.
WORKSPACES_HOST_PATH=/tmp/ide-workspaces

# Set to "true" to skip Docker container creation (local dev without Docker)
DISABLE_CONTAINERS=false

# Default image used when a repo has no .devcontainer/devcontainer.json
DEFAULT_CONTAINER_IMAGE=ghcr.io/devcontainers/base:ubuntu

# Auto-sleep: minutes of inactivity before stopping the workspace container
SLEEP_TIMEOUT_MINUTES=30

# Optional — connect the IDE to the existing platform
# PLATFORM_API_URL=http://localhost:3000
# AGENT_SERVICE_URL=http://localhost:8000
# PLATFORM_JWT_SECRET=

# Frontend (Vite)
VITE_IDE_SERVER_URL=http://localhost:4000
