{
  "name": "ide",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "client:install": "bun run --filter=ide-client install",
    "client:dev": "bun run --filter=ide-client dev",
    "client:build": "bun run --filter=ide-client build",
    "server:install": "bun run --filter=ide-server install",
    "server:dev": "bun run --filter=ide-server dev",
    "server:build": "bun run --filter=ide-server build"
  }
}
