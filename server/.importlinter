     telaios.modules.internal.router -> telaios.modules.plans.schemas
     telaios.modules.internal.router -> telaios.modules.tasks.service
     telaios.modules.internal.router -> telaios.modules.tasks.artifacts.schemas
     telaios.modules.internal.router -> telaios.modules.tasks.artifacts.service
     telaios.modules.internal.router -> telaios.modules.projects.agents.service
     telaios.modules.internal.router -> telaios.modules.library.service
     telaios.modules.internal.router -> telaios.modules.users.schemas
     telaios.modules.internal.router -> telaios.modules.users.service
     # containers — intra (no cross-module reads needed)
     telaios.modules.containers -> telaios.modules.containers.router
      # docker_shell — intra
      telaios.modules.docker_shell -> telaios.modules.docker_shell.router
