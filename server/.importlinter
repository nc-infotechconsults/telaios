    telaios.modules.documents.chunks -> telaios.modules.documents.chunks.service
    telaios.modules.documents.chunks.service -> telaios.modules.documents.chunks.repository
    # document_llm — intra (pure LLM utility, no HTTP)
    telaios.modules.document_llm -> telaios.modules.document_llm.service
    # document_extraction — intra
