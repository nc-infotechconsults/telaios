    telaios.modules.document_extraction.service -> telaios.modules.document_extraction.service_helpers
    telaios.modules.document_extraction.schemas -> telaios.modules.document_llm.schemas
    # document_extraction cross-module — allowed reads from documents.* and document_llm
    telaios.modules.document_extraction.router -> telaios.modules.documents.repository
    telaios.modules.document_extraction.service_helpers -> telaios.modules.documents.chunks.service
    telaios.modules.document_extraction.service_helpers -> telaios.modules.document_llm.service
    # document_copilot — intra
    telaios.modules.document_copilot -> telaios.modules.document_copilot.router
    telaios.modules.document_copilot.router -> telaios.modules.document_copilot.schemas
    telaios.modules.document_copilot.router -> telaios.modules.document_copilot.service
    # document_copilot cross-module — reads from documents.*
    telaios.modules.document_copilot.router -> telaios.modules.documents.repository
    telaios.modules.document_copilot.service -> telaios.modules.documents.chunks.service
    telaios.modules.document_copilot.service -> telaios.modules.documents.service
    # skills — intra (no repository; filesystem-backed)
     telaios.modules.skills -> telaios.modules.skills.router
     telaios.modules.skills.router -> telaios.modules.skills.schemas
     telaios.modules.skills.router -> telaios.modules.skills.service
     # health — intra (cross-layer reads from infra + db allowed via contract A exemption)
     telaios.modules.health -> telaios.modules.health.router
     # analytics — intra
     telaios.modules.analytics -> telaios.modules.analytics.router
     telaios.modules.analytics.router -> telaios.modules.analytics.schemas
     telaios.modules.analytics.router -> telaios.modules.analytics.service
     telaios.modules.analytics.service -> telaios.modules.analytics.schemas
     # internal — intra + cross-module service reads (allowed)
     telaios.modules.internal -> telaios.modules.internal.router
     telaios.modules.internal.router -> telaios.modules.internal.schemas
     telaios.modules.internal.router -> telaios.modules.documents.service
     telaios.modules.internal.router -> telaios.modules.documents.chunks.service
     telaios.modules.internal.router -> telaios.modules.documents.schemas
