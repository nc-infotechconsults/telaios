[importlinter]
root_packages =
    telaios

# Contract A: cross-cutting layers must NEVER import from modules.* (no upward dependencies).
# This is the single hard rule we need at Phase 0.
[importlinter:contract:layered-shared-no-upward-deps]
name = Shared layers cannot depend on business modules
type = forbidden
source_modules =
    telaios.core
    telaios.tools
    telaios.infra
    telaios.db
    telaios.auth
    telaios.utils
    telaios.config
forbidden_modules =
    telaios.modules

# Contract B: each module's public facade is `modules.<X>` / `__init__` / `service` / `schemas`.
# Cross-module imports of `repository` / `router` are forbidden.
# Implemented as a forbidden-glob contract; will be expanded per-module in Phase 1+
# as the package contents fill in. Currently empty packages so this is a no-op enforcement.
[importlinter:contract:no-cross-module-internal-imports]
name = Modules must not import each other's repository or router
type = forbidden
source_modules =
    telaios.modules
forbidden_modules =
    telaios.modules
include_external_packages = False
allow_indirect_imports = True
# Intra-module wiring is always allowed (router→service, service→repository, etc.).
# Only cross-module imports of .repository / .router are forbidden.
ignore_imports =
    telaios.modules.users -> telaios.modules.users.router
    telaios.modules.users -> telaios.modules.users.service
    telaios.modules.users.router -> telaios.modules.users.schemas
    telaios.modules.users.router -> telaios.modules.users.service
    telaios.modules.users.service -> telaios.modules.users.repository
    telaios.modules.users.service -> telaios.modules.users.schemas
    telaios.modules.workspaces -> telaios.modules.workspaces.router
    telaios.modules.workspaces -> telaios.modules.workspaces.service
    telaios.modules.workspaces.router -> telaios.modules.workspaces.repository
    telaios.modules.workspaces.router -> telaios.modules.workspaces.schemas
    telaios.modules.workspaces.router -> telaios.modules.workspaces.service
    telaios.modules.workspaces.service -> telaios.modules.workspaces.repository
    telaios.modules.workspaces.service -> telaios.modules.workspaces.schemas
    telaios.modules.projects -> telaios.modules.projects.router
    telaios.modules.projects -> telaios.modules.projects.service
    telaios.modules.projects -> telaios.modules.projects.agents.router
    telaios.modules.projects -> telaios.modules.projects.members.router
    telaios.modules.projects.router -> telaios.modules.projects.schemas
    telaios.modules.projects.router -> telaios.modules.projects.service
     telaios.modules.projects.service -> telaios.modules.projects.repository
     telaios.modules.projects.service -> telaios.modules.projects.schemas
     telaios.modules.projects.service -> telaios.modules.projects.members.service
     telaios.modules.projects.agents.router -> telaios.modules.projects.agents.service
     telaios.modules.projects.agents.router -> telaios.modules.projects.schemas
     telaios.modules.projects.agents.service -> telaios.modules.projects.agents.repository
     telaios.modules.projects.agents.service -> telaios.modules.projects.schemas
     telaios.modules.projects.members.router -> telaios.modules.projects.members.service
     telaios.modules.projects.members.router -> telaios.modules.projects.schemas
     telaios.modules.projects.members.service -> telaios.modules.projects.members.repository
     telaios.modules.projects.members.service -> telaios.modules.projects.schemas
     telaios.modules.projects.members.repository -> telaios.modules.projects.schemas
    telaios.modules.repositories -> telaios.modules.repositories.router
    telaios.modules.repositories -> telaios.modules.repositories.service
    telaios.modules.repositories.router -> telaios.modules.repositories.schemas
    telaios.modules.repositories.router -> telaios.modules.repositories.service
    telaios.modules.repositories.service -> telaios.modules.repositories.repository
    telaios.modules.repositories.service -> telaios.modules.repositories.schemas
    telaios.modules.environments -> telaios.modules.environments.router
    telaios.modules.environments -> telaios.modules.environments.service
    telaios.modules.environments.router -> telaios.modules.environments.schemas
    telaios.modules.environments.router -> telaios.modules.environments.service
    telaios.modules.environments.service -> telaios.modules.environments.repository
    telaios.modules.environments.service -> telaios.modules.environments.schemas
    telaios.modules.settings -> telaios.modules.settings.router
    telaios.modules.settings -> telaios.modules.settings.llm_router
    telaios.modules.settings -> telaios.modules.settings.service
    telaios.modules.settings.router -> telaios.modules.settings.schemas
    telaios.modules.settings.router -> telaios.modules.settings.service
    telaios.modules.settings.service -> telaios.modules.settings.repository
    telaios.modules.settings.service -> telaios.modules.settings.schemas
    telaios.modules.library -> telaios.modules.library.router
    telaios.modules.library -> telaios.modules.library.service
    telaios.modules.library.router -> telaios.modules.library.schemas
    telaios.modules.library.router -> telaios.modules.library.service
    telaios.modules.library.service -> telaios.modules.library.repository
    telaios.modules.library.service -> telaios.modules.library.schemas
    telaios.modules.agent_profiles -> telaios.modules.agent_profiles.router
    telaios.modules.agent_profiles -> telaios.modules.agent_profiles.service
    telaios.modules.agent_profiles.router -> telaios.modules.agent_profiles.schemas
    telaios.modules.agent_profiles.router -> telaios.modules.agent_profiles.service
    telaios.modules.agent_profiles.service -> telaios.modules.agent_profiles.schemas
    telaios.modules.agent_profiles.service -> telaios.modules.library.repository
    # plans module — intra
    telaios.modules.plans -> telaios.modules.plans.router
    telaios.modules.plans -> telaios.modules.plans.service
    telaios.modules.plans -> telaios.modules.plans.schemas
    telaios.modules.plans.router -> telaios.modules.plans.schemas
    telaios.modules.plans.router -> telaios.modules.plans.service
    telaios.modules.plans.router -> telaios.modules.plans.repository
    telaios.modules.plans.service -> telaios.modules.plans.repository
    telaios.modules.plans.service -> telaios.modules.plans.schemas
    telaios.modules.plans.session -> telaios.modules.plans.parser
    telaios.modules.plans.session -> telaios.modules.plans.persistence
    telaios.modules.plans.session -> telaios.modules.plans.prompts
    telaios.modules.plans.parser -> telaios.modules.plans.prompts
    # plans.router cross-module (allowed)
    telaios.modules.plans.router -> telaios.modules.tasks.service
    telaios.modules.plans.router -> telaios.modules.messages.service
    telaios.modules.plans.router -> telaios.modules.messages.schemas
    telaios.modules.plans.router -> telaios.modules.orchestration.service
    # tasks module — intra
    telaios.modules.tasks -> telaios.modules.tasks.router
    telaios.modules.tasks -> telaios.modules.tasks.service
    telaios.modules.tasks -> telaios.modules.tasks.schemas
    telaios.modules.tasks.router -> telaios.modules.tasks.schemas
    telaios.modules.tasks.router -> telaios.modules.tasks.service
    telaios.modules.tasks.router -> telaios.modules.tasks.repository
    telaios.modules.tasks.service -> telaios.modules.tasks.repository
    telaios.modules.tasks.service -> telaios.modules.tasks.schemas
    telaios.modules.tasks.router -> telaios.modules.tasks.artifacts.schemas
    telaios.modules.tasks.router -> telaios.modules.tasks.artifacts.service
    telaios.modules.tasks.artifacts -> telaios.modules.tasks.artifacts.schemas
    telaios.modules.tasks.artifacts -> telaios.modules.tasks.artifacts.service
    telaios.modules.tasks.artifacts.service -> telaios.modules.tasks.artifacts.repository
    telaios.modules.tasks.artifacts.service -> telaios.modules.tasks.artifacts.schemas
    # tasks.router cross-module (allowed)
    telaios.modules.tasks.router -> telaios.modules.plans.repository
    # messages module — intra
    telaios.modules.messages -> telaios.modules.messages.router
    telaios.modules.messages -> telaios.modules.messages.service
    telaios.modules.messages -> telaios.modules.messages.schemas
    telaios.modules.messages.router -> telaios.modules.messages.schemas
    telaios.modules.messages.router -> telaios.modules.messages.service
    telaios.modules.messages.service -> telaios.modules.messages.repository
    telaios.modules.messages.service -> telaios.modules.messages.schemas
    # orchestration module — intra
    telaios.modules.orchestration -> telaios.modules.orchestration.service
    # chat module — intra + cross-module (allowed)
    telaios.modules.chat -> telaios.modules.chat.router
    telaios.modules.chat.router -> telaios.modules.plans.repository
    telaios.modules.chat.router -> telaios.modules.plans.prompts
    telaios.modules.chat.router -> telaios.modules.plans.schemas
    telaios.modules.chat.router -> telaios.modules.plans.service
    telaios.modules.chat.router -> telaios.modules.messages.schemas
    telaios.modules.chat.router -> telaios.modules.messages.service
    telaios.modules.chat.router -> telaios.modules.documents.service
    telaios.modules.chat.router -> telaios.modules.documents.chunks.service
    telaios.modules.chat.router -> telaios.modules.repositories.service
    telaios.modules.chat.router -> telaios.modules.tasks.schemas
    telaios.modules.chat.router -> telaios.modules.tasks.service
    # documents module — facade
    telaios.modules.documents -> telaios.modules.documents.router
    telaios.modules.documents -> telaios.modules.documents.service
    telaios.modules.documents -> telaios.modules.documents.schemas
    telaios.modules.documents -> telaios.modules.documents.activities.router
    telaios.modules.documents -> telaios.modules.documents.comments.router
    telaios.modules.documents -> telaios.modules.documents.favorites.router
    telaios.modules.documents -> telaios.modules.documents.folders.router
    telaios.modules.documents -> telaios.modules.documents.tags.router
    telaios.modules.documents -> telaios.modules.documents.templates.router
    telaios.modules.documents -> telaios.modules.documents.versions.router
    # documents core — intra
    telaios.modules.documents.router -> telaios.modules.documents.repository
    telaios.modules.documents.router -> telaios.modules.documents.schemas
    telaios.modules.documents.router -> telaios.modules.documents.service
    telaios.modules.documents.service -> telaios.modules.documents.repository
    telaios.modules.documents.service -> telaios.modules.documents.schemas
    telaios.modules.documents.service -> telaios.modules.documents.chunks.service
    # documents/folders — intra
    telaios.modules.documents.folders -> telaios.modules.documents.folders.router
    telaios.modules.documents.folders -> telaios.modules.documents.folders.schemas
    telaios.modules.documents.folders -> telaios.modules.documents.folders.service
    telaios.modules.documents.folders.router -> telaios.modules.documents.folders.schemas
    telaios.modules.documents.folders.router -> telaios.modules.documents.folders.service
    telaios.modules.documents.folders.service -> telaios.modules.documents.folders.repository
    telaios.modules.documents.folders.service -> telaios.modules.documents.folders.schemas
    # documents/tags — intra + cross-subpackage
    telaios.modules.documents.tags -> telaios.modules.documents.tags.router
    telaios.modules.documents.tags -> telaios.modules.documents.tags.schemas
    telaios.modules.documents.tags -> telaios.modules.documents.tags.service
    telaios.modules.documents.tags.router -> telaios.modules.documents.repository
    telaios.modules.documents.tags.router -> telaios.modules.documents.tags.schemas
    telaios.modules.documents.tags.router -> telaios.modules.documents.tags.service
    telaios.modules.documents.tags.service -> telaios.modules.documents.tags.repository
    telaios.modules.documents.tags.service -> telaios.modules.documents.tags.schemas
    # documents/versions — intra + cross-subpackage
    telaios.modules.documents.versions -> telaios.modules.documents.versions.router
    telaios.modules.documents.versions -> telaios.modules.documents.versions.schemas
    telaios.modules.documents.versions -> telaios.modules.documents.versions.service
    telaios.modules.documents.versions.router -> telaios.modules.documents.repository
    telaios.modules.documents.versions.router -> telaios.modules.documents.versions.schemas
    telaios.modules.documents.versions.router -> telaios.modules.documents.versions.service
    telaios.modules.documents.versions.service -> telaios.modules.documents.versions.repository
    telaios.modules.documents.versions.service -> telaios.modules.documents.versions.schemas
    # documents/comments — intra + cross-subpackage
    telaios.modules.documents.comments -> telaios.modules.documents.comments.router
    telaios.modules.documents.comments -> telaios.modules.documents.comments.schemas
    telaios.modules.documents.comments -> telaios.modules.documents.comments.service
    telaios.modules.documents.comments.router -> telaios.modules.documents.repository
    telaios.modules.documents.comments.router -> telaios.modules.documents.comments.schemas
    telaios.modules.documents.comments.router -> telaios.modules.documents.comments.service
    telaios.modules.documents.comments.service -> telaios.modules.documents.comments.repository
    telaios.modules.documents.comments.service -> telaios.modules.documents.comments.schemas
    # documents/activities — intra + cross-subpackage
    telaios.modules.documents.activities -> telaios.modules.documents.activities.router
    telaios.modules.documents.activities -> telaios.modules.documents.activities.schemas
    telaios.modules.documents.activities -> telaios.modules.documents.activities.service
    telaios.modules.documents.activities.router -> telaios.modules.documents.repository
    telaios.modules.documents.activities.router -> telaios.modules.documents.activities.schemas
    telaios.modules.documents.activities.router -> telaios.modules.documents.activities.service
    telaios.modules.documents.activities.service -> telaios.modules.documents.activities.repository
    telaios.modules.documents.activities.service -> telaios.modules.documents.activities.schemas
    # documents/favorites — intra + cross-subpackage
    telaios.modules.documents.favorites -> telaios.modules.documents.favorites.router
    telaios.modules.documents.favorites -> telaios.modules.documents.favorites.schemas
    telaios.modules.documents.favorites -> telaios.modules.documents.favorites.service
    telaios.modules.documents.favorites.router -> telaios.modules.documents.repository
    telaios.modules.documents.favorites.router -> telaios.modules.documents.favorites.schemas
    telaios.modules.documents.favorites.router -> telaios.modules.documents.favorites.service
    telaios.modules.documents.favorites.service -> telaios.modules.documents.favorites.repository
    telaios.modules.documents.favorites.service -> telaios.modules.documents.favorites.schemas
    # documents/templates — intra
    telaios.modules.documents.templates -> telaios.modules.documents.templates.router
    telaios.modules.documents.templates -> telaios.modules.documents.templates.schemas
    telaios.modules.documents.templates -> telaios.modules.documents.templates.service
    telaios.modules.documents.templates.router -> telaios.modules.documents.templates.schemas
    telaios.modules.documents.templates.router -> telaios.modules.documents.templates.service
    telaios.modules.documents.templates.service -> telaios.modules.documents.templates.repository
    telaios.modules.documents.templates.service -> telaios.modules.documents.templates.schemas
    # documents/chunks — intra
