{
  "name": "telaio-data-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "test": "jest --config jest.config.ts",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --forceExit",
    "test:all": "bun test && bun run test:integration",
    "migration:generate": "bun node_modules/typeorm/cli.js migration:generate -d src/configs/data-source.config.ts src/migrations/migration",
    "migration:run": "bun node_modules/typeorm/cli.js migration:run -d src/configs/data-source.config.ts",
    "migration:revert": "bun node_modules/typeorm/cli.js migration:revert -d src/configs/data-source.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@kubernetes/client-node": "^1.4.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dockerode": "^4.0.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.11.6",
    "@types/pino": "^7.0.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
