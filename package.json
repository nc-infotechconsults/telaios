{
  "name": "swe-ai-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "data-api",
    "agent-service",
    "tests"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=swe-ai-platform-frontend",
    "dev:demo": "npm run dev:demo --workspace=swe-ai-platform-frontend",
    "dev:api": "npm run dev --workspace=swe-ai-data-api",
    "dev:agent": "npm run dev --workspace=swe-ai-agent-service",
    "test": "npm run test --workspace=swe-ai-platform-tests",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "vite": "^5.4.2"
  }
}
