{
  "name": "telaios",
  "private": true,
  "version": "0.1.0",
  "description": "Root workspace for TelaiOS's Bun-managed apps and Python agent service",
  "workspaces": [
    "packages/*",
    "frontend",
    "data-api",
    "tests"
  ],
  "scripts": {
    "apps:install": "bun run --filter='*' install",
    "apps:dev": "bun run --filter='*' dev",
    "apps:build": "bun run --filter='*' build",
    "agent:install": "python -m pip install -e 'agent-service[dev]'",
    "agent:dev": "cd agent-service && uvicorn agent_service.main:app --reload --host 0.0.0.0 --port 8000",
    "agent:build": "cd agent-service && pip install -e .",
    "agent:test": "cd agent-service && python -m pytest tests/ -v",
    "data:install": "bun run --filter=data-api install",
    "data:dev": "cd data-api && bun run dev",
    "data:build": "cd data-api && bun run build",
    "frontend:install": "bun run --filter=frontend install",
    "frontend:dev": "cd frontend && bun run dev",
    "frontend:build": "cd frontend && bun run build",
    "docker:postgres": "docker compose -f docker-compose.dev.yml up -d postgres",
    "docker:redis": "docker compose -f docker-compose.dev.yml up -d redis",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "test": "bun run --filter=./tests test",
    "build": "bun run apps:build && bun run agent:build",
    "typecheck": "bun run --filter='*' typecheck"
  }
}
